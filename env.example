# Copie para .env (nesta mesma pasta) e preencha. Nunca commite o .env de
# verdade — só este .example fica no controle de versão.

# Modelos (config/config.toml referencia esses nomes em api_key_env)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CHATTUI_VPS_KEY=

# Plugin trilium_note.py + /export trilium (opcional)
TRILIUM_URL=
TRILIUM_TOKEN=
# Root do Journal do /export trilium (id da nota mãe do seu diário) —
# preencha localmente no seu .env; não há default no código.
TRILIUM_JOURNAL_ROOT=
# Nota mãe padrão do plugin trilium_note (opcional; sem isso usa o
# placeholder do plugin pra você trocar no próprio arquivo).
TRILIUM_PARENT_ID=
